<?xml version="1.0" encoding="utf-8"?><!--
   Consulted on API < 31 (dataExtractionRules.xml is authoritative on 31+, but this is still
   the real fallback below that, per the Auto Backup docs).
-->
<full-backup-content>
    <!--
      ADR-0005: TokenManager's secrets (JWT, refresh token, PIN, pattern) are encrypted with a
      Tink keyset wrapped by an Android Keystore key. That key is device-bound and never
      leaves the device — a value restored from backup on a new device can never be decrypted
      there, so both files below must never be backed up in the first place:
        - pesamind_prefs.preferences_pb: the DataStore file TokenManager writes to.
        - pesamind_token_keyset_prefs.xml: the wrapped Tink keyset itself (TokenCryptoManager).
    -->
    <exclude domain="file" path="datastore/pesamind_prefs.preferences_pb" />
    <exclude domain="sharedpref" path="pesamind_token_keyset_prefs.xml" />
</full-backup-content>